{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "PC Agent",
    "shortDescription": "Local PC diagnostics with an explaining AI",
    "resources": {
      "../../target/release/pcagent-elevated.exe": "pcagent-elevated.exe",
      "../../target/release/pcagent.exe": "pcagent.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "displayLanguageSelector": true,
        "installerHooks": "./installer/hooks.nsh"
      }
    }
  }
}
