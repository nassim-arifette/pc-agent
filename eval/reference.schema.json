{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local C/D/E evaluation reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "configuration", "model", "reasoning_effort", "scenario_sha256", "question", "sharing", "answer", "evidence_basis"],
  "properties": {
    "schema_version": {"const": 1},
    "configuration": {"enum": ["C", "D", "E"]},
    "model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"enum": ["medium", "low", "high", "synthetic"]},
    "harness_test": {"type": "boolean"},
    "scenario_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "question": {"type": "string", "minLength": 1},
    "sharing": {"enum": ["complete", "anonymized"]},
    "answer": {"type": "string", "minLength": 1},
    "evidence_basis": {"enum": ["same_replay", "capture_time"]},
    "trace_file": {"type": "string", "minLength": 1},
    "started_at_unix_ms": {"type": "integer", "minimum": 1},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "cost_usd": {"type": ["string", "null"], "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "unverified": {"type": ["array", "null"], "items": {"type": "object"}},
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "evidence_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": {"enum": ["commands", "screenshot"]},
          "path": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["harness_test"], "properties": {"harness_test": {"const": true}}},
      "then": {"properties": {"model": {"const": "synthetic-test-model-c"}, "reasoning_effort": {"const": "synthetic"}}},
      "else": {
        "oneOf": [
          {"properties": {"model": {"const": "Claude Sonnet 5.5"}, "reasoning_effort": {"const": "medium"}}},
          {"properties": {"model": {"const": "gpt-6.1-sol"}, "reasoning_effort": {"const": "low"}}},
          {"properties": {"model": {"const": "gpt-5.6-terra"}, "reasoning_effort": {"const": "high"}}}
        ]
      }
    },
    {
      "if": {"properties": {"configuration": {"const": "C"}}},
      "then": {
        "required": ["trace_file", "tool_registry_sha256"],
        "properties": {"evidence_basis": {"const": "same_replay"}}
      },
      "else": {
        "required": ["started_at_unix_ms", "evidence_files"],
        "properties": {
          "evidence_basis": {"const": "capture_time"},
          "evidence_files": {"minItems": 1}
        }
      }
    }
  ]
}
