# Documentation only. PC Agent reads these settings from the process environment, then from
# %APPDATA%\pcagent\.env (the desktop app writes that file for you). A .env file in the current
# folder is never read. Never commit a real key.
NEBIUS_API_KEY=
# An nvidia/...Nemotron... ID from your account's model catalog (pcagent models --allow-cloud).
NEBIUS_MODEL_ID=
# Optional: on (default), low or off.
NEBIUS_REASONING=
# Optional: a Tavily API key, for the web lookups.
TAVILY_API_KEY=
